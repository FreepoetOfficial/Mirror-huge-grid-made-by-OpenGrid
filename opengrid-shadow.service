[Unit]
Description=OpenGrid realtime silhouette
After=network-online.target

[Service]
Type=simple
User=__TARGET_USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/python __APP_DIR__/app.py --config __APP_DIR__/config.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
